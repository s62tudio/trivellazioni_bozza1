/**
 * Cloudflare Workers — sito statico Trivellazioni Italia
 *
 * Il sito Next.js viene esportato come HTML statico in `site/out`
 * (`npm run build`) e servito dal Worker come asset statici.
 *
 * Impostazioni consigliate in Cloudflare › Workers › Settings › Build:
 *   Build command:  npm run build
 *   Deploy command: npx wrangler deploy
 *   Root directory: /   (radice del repository)
 *
 * IMPORTANTE: "name" deve coincidere con il nome del Worker collegato
 * al repository nella dashboard di Cloudflare.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trivellazioni-bozza1",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site/out",
    // pagine come /storia servite da storia.html, senza slash finale
    "html_handling": "drop-trailing-slash",
    // indirizzi inesistenti → pagina 404 del sito
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
